      "parameters": {
        "type": "object",
        "properties": { "cluster_id": { "type": "string" } },
        "required": ["cluster_id"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_cluster_config",
      "description": "클러스터 설정을 반환한다. node_type_id, spark_conf(스토리지 접근 방식 포함), vnet/subnet, 리전, 연결된 cluster policy 등.",
      "parameters": {
        "type": "object",
        "properties": { "cluster_id": { "type": "string" } },
        "required": ["cluster_id"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_azure_resource",
      "description": "Azure 리소스 설정을 조회한다. type 에 따라 다른 정보를 반환한다.",
      "parameters": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["role_assignments", "storage_account", "dns_zone_links"],
            "description": "role_assignments: 주체의 역할 목록 / storage_account: HNS·방화벽·VNet 허용목록 / dns_zone_links: Private DNS Zone 의 VNet 링크 목록"
          },
          "name": { "type": "string", "description": "리소스 이름 또는 주체 ID" }
        },
        "required": ["type", "name"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "nslookup",
      "description": "지정한 위치에서 호스트명을 DNS 조회한 결과를 반환한다.",
      "parameters": {
        "type": "object",
        "properties": {
          "host": { "type": "string" },
          "source": { "type": "string", "enum": ["jumpbox", "cluster"], "description": "조회를 실행하는 위치" }
        },
        "required": ["host", "source"],
        "additionalProperties": false
      }
    }
  },
  {
