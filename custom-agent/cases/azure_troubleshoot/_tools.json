      "parameters": {
        "type": "object",
        "properties": {
          "securable_type": { "type": "string", "enum": ["storage_credential", "external_location"] },
          "name": { "type": "string" }
        },
        "required": ["securable_type", "name"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_uc_grants",
      "description": "Unity Catalog 시큐러블에 부여된 권한(grant) 목록을 반환한다. READ FILES / WRITE FILES / USE 등.",
      "parameters": {
        "type": "object",
        "properties": {
          "securable_type": { "type": "string", "enum": ["external_location", "catalog", "schema", "table"] },
          "name": { "type": "string" }
        },
        "required": ["securable_type", "name"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_cluster_policy",
