# Python env / caches
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Per-candidate outputs: commit the deck (slides.html) + grading result
# (grade_results.json) only. Everything else is regenerated by run_task.py /
# grade_tasks.py and stays out of git.
*/*/screenshots/
*/gallery/
*/*/run_meta.json
*/*/slides.aborted.html
*/*/instructions.txt
*/*/prompt.txt
*/*/agent_output.log

# Secrets (never commit)
.env
*.token
access_token

# mle-benchmark harness working data — rebuilt locally by fetch_raw25.py /
# prepare.py. `private/` holds hidden-split ANSWER KEYS: never commit.
mle-benchmark/raw/
mle-benchmark/packs/
mle-benchmark/private/
mle-benchmark/results/direct/
mle-benchmark/results/*.log
