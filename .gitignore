# Python env / caches
.venv/
.graderenv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Per-candidate outputs: commit the deck (slides.html) + grading result
# (grade_results.json) only. Everything else is regenerated by run_task.py /
# grade_tasks.py and stays out of git.
*/*/screenshots/
*/gallery/
*/*/run_meta.json
*/*/slides.aborted.html
*/*/instructions.txt
*/*/prompt.txt
*/*/agent_output.log

# databricks-app-generation: 3-level layout <task>/<tier>/<candidate>/. Commit the
# app source (app/*) + grade_results.json + contracts only; everything below is
# regenerated by run_task.py / grade_tasks.py.
*/*/*/run_meta.json
*/*/*/raw_completion.txt
*/*/*/app_boot.log
*/*/*/agent_output.log
*/*/*/instructions.txt
*/*/*/prompt.txt
*/*/*/screenshots/
databricks-app-generation/*/*/legacy_app/

# Secrets (never commit)
.env
*.token
access_token
